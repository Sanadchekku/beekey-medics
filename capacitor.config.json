{
  "appId": "com.beekey.medics",
  "appName": "Beekey Medics",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native"
    }
  },
  "ios": {
    "contentInset": "never"
  }
}
